# Disabled by default: the public site uses its original bundled paragraph.
# Enable only after the migration, account grant, and backend checks are complete.
CMS_ENABLED=false
SITE_URL=http://localhost:4321
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Required only for the image-upload lifecycle; never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=
R2_PUBLISHED_BUCKET=
# Verified published-only delivery prefix, e.g. https://images.dextery.dev/anya-portfolio
R2_PUBLIC_BASE_URL=
