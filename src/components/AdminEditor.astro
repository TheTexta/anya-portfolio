---
import type { PortfolioRecord } from "../lib/cms/content";
import { serializedForHtml } from "../lib/cms/content";
import { bundledImages } from "../lib/cms/bundled-images";
import { publicImageUrl } from "../lib/cms/config.server";

interface Props { record: PortfolioRecord; canUpload: boolean }
const { record, canUpload } = Astro.props;
const initial = {
  record, canUpload,
  bundled: { tvm: bundledImages.tvm.src, "post-credits": bundledImages["post-credits"].src },
  uploaded: Object.fromEntries(record.document.links.flatMap((link) =>
    link.image?.kind === "upload" ? [[link.image.id, publicImageUrl(link.image.id)]] : [])),
};
const button = "min-h-11 cursor-pointer border border-black px-4 py-2 text-sm hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-white disabled:hover:text-black";
const field = "mt-2 block min-h-11 w-full border border-black bg-white px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black disabled:opacity-50";
---
<div id="portfolio-editor" class="mx-auto max-w-6xl px-6 py-8 sm:px-10 sm:py-12">
  <header class="flex flex-wrap items-start justify-between gap-6 border-b border-black pb-7">
    <div>
      <h1 class="text-2xl font-medium">Portfolio editor</h1>
      <p class="mt-2 max-w-prose text-sm leading-relaxed">Your paragraph, links, and the previews behind them.</p>
    </div>
    <nav aria-label="Editor actions" class="flex flex-wrap items-center gap-3">
      <a href="/" target="_blank" rel="noopener" class="px-2 py-3 text-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2">View site<span class="sr-only"> (opens a new tab)</span></a>
      <form action="/api/admin/logout" method="post"><button class={button} type="submit">Sign out</button></form>
      <button id="publish" class={`${button} bg-black text-white disabled:bg-white disabled:text-black`} type="button" disabled>Publish changes</button>
    </nav>
  </header>
  <main id="admin-main" class="pt-8">
    <p id="editor-status" role="status" aria-live="polite" class="mb-8 min-h-6 max-w-prose text-sm leading-relaxed">Loading the editor…</p>
    <noscript><p class="mb-8 border border-black p-4">Enable JavaScript to edit your paragraph. The public portfolio works without it.</p></noscript>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(18rem,1fr)] lg:gap-12">
      <section aria-labelledby="paragraph-heading" class="min-w-0">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 id="paragraph-heading" class="text-lg font-medium">Paragraph</h2>
          <button id="toggle-preview" type="button" aria-pressed="false" class="min-h-11 cursor-pointer px-2 text-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2">Preview paragraph</button>
        </div>
        <p id="paragraph-help" class="mt-2 max-w-prose text-sm leading-relaxed">Select words to add a link. Select an existing linked phrase to edit its preview.</p>
        <div id="edit-surface" class="mt-5 border border-black">
          <div role="toolbar" aria-label="Paragraph tools" class="flex flex-wrap gap-1 border-b border-black p-2">
            <button id="add-link" type="button" class={button} disabled>Add link</button>
            <button id="remove-link" type="button" class={button} disabled>Unlink</button>
            <button id="undo" type="button" class={button} disabled>Undo</button>
            <button id="redo" type="button" class={button} disabled>Redo</button>
          </div>
          <div id="paragraph-input" class="min-h-64 p-5 text-lg leading-relaxed sm:p-6 [&_.ProseMirror]:min-h-52 [&_.ProseMirror]:whitespace-pre-wrap [&_.ProseMirror]:break-words [&_.ProseMirror]:outline-none [&_.ProseMirror]:focus-visible:outline-2 [&_.ProseMirror]:focus-visible:outline-offset-4 [&_.ProseMirror]:focus-visible:outline-black"></div>
        </div>
        <div id="paragraph-preview" hidden class="mt-5 min-h-64 border border-black px-6 py-12">
          <p id="preview-copy" class="text-center text-xl leading-relaxed sm:text-2xl"></p>
          <p class="mt-8 text-center text-sm">Select a linked phrase to see its preview below.</p>
        </div>
        <div class="mt-7">
          <h3 class="text-sm font-medium">Links in this paragraph</h3>
          <div id="link-list" class="mt-2 flex flex-wrap gap-2"></div>
        </div>
      </section>
      <section aria-labelledby="link-heading" class="min-w-0 border-t border-black pt-7 lg:border-t-0 lg:pt-0">
        <h2 id="link-heading" class="text-lg font-medium">Link preview</h2>
        <p id="link-empty" class="mt-2 max-w-prose text-sm leading-relaxed">Select a linked phrase in your paragraph, or select words and choose Add link.</p>
        <form id="link-form" hidden class="mt-5" autocomplete="off">
          <fieldset id="link-fields" class="min-w-0 space-y-5">
            <legend class="sr-only">Selected link details</legend>
            <p id="linked-words" class="break-words text-sm leading-relaxed"></p>
            <label class="block text-sm font-medium" for="link-href">Destination
              <input id="link-href" data-field="href" type="url" maxlength="2048" required placeholder="https://" class={field} />
            </label>
            <label class="block text-sm font-medium" for="link-title">Preview title
              <input id="link-title" data-field="title" type="text" maxlength="160" required class={field} />
            </label>
            <label class="block text-sm font-medium" for="link-summary">Preview description
              <textarea id="link-summary" data-field="summary" maxlength="600" rows="3" class={field}></textarea>
            </label>
            <div>
              <label for="link-image" class="text-sm font-medium">Preview image</label>
              <select id="link-image" class={field}>
                <option value="none">No image</option>
                <option value="tvm">TVM logo</option>
                <option value="post-credits">Post-Credits cover</option>
                <option value="upload" hidden>Uploaded image</option>
              </select>
              <label for="image-upload" class="mt-3 block text-sm">Upload a replacement</label>
              <input id="image-upload" type="file" accept="image/jpeg,image/png,image/webp" disabled={!canUpload}
                class="mt-2 block w-full min-w-0 text-sm file:mr-3 file:min-h-11 file:cursor-pointer file:border file:border-black file:bg-white file:px-3 file:py-2 file:text-black file:hover:bg-black file:hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 disabled:opacity-50" />
              <p class="mt-2 text-sm leading-relaxed">JPEG, PNG, or WebP. Up to 5 MB and 24 megapixels. {canUpload ? "Uploads stay private until you publish." : "Uploads will be available when image storage is configured."}</p>
              <p id="upload-status" role="status" aria-live="polite" class="mt-2 text-sm leading-relaxed"></p>
            </div>
            <div id="image-alt-label">
              <label class="block text-sm font-medium" for="link-image-alt">Image description</label>
              <input id="link-image-alt" data-field="imageAlt" type="text" maxlength="200" aria-describedby="image-alt-help" class={field} />
              <p id="image-alt-help" class="mt-2 text-sm leading-relaxed">Briefly describe the image for people using screen readers.</p>
            </div>
          </fieldset>
        </form>
        <div id="selected-preview" hidden class="mt-8 border border-black p-4 text-sm leading-normal">
          <h3 class="sr-only">Selected link preview</h3>
          <img id="selected-image" alt="" width="512" height="320" hidden class="mb-3 h-40 w-full object-contain" />
          <p id="selected-title" class="break-words font-medium"></p>
          <p id="selected-summary" class="mt-1 break-words"></p>
        </div>
      </section>
    </div>
  </main>
</div>
<script id="editor-data" type="application/json" set:html={serializedForHtml(initial)} />
<script>
  import "../scripts/admin-editor";
</script>
