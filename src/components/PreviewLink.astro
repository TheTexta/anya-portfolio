---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  href: string;
  title: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { id, href, title, summary, image, imageAlt = "" } = Astro.props;
---

<span class="group relative" data-preview data-open="false">
  <a
    href={href}
    aria-describedby={`${id}-summary`}
    class="underline decoration-dotted decoration-1 underline-offset-4 focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-black"
  ><slot /></a>
  <span
    role="tooltip"
    class="invisible fixed bottom-6 left-1/2 z-10 w-72 max-w-[calc(100vw-3rem)] -translate-x-1/2 pb-3 text-left text-sm leading-normal group-data-[open=true]:visible [@media(min-width:1024px)_and_(min-height:700px)]:absolute [@media(min-width:1024px)_and_(min-height:700px)]:bottom-full"
  >
    <span class="block border border-black bg-white p-4">
      {image && (
        <Image
          src={image}
          alt={imageAlt}
          width={512}
          format="webp"
          class="mb-3 h-40 w-full object-contain"
        />
      )}
      <span class="block font-medium">{title}</span>
      <span id={`${id}-summary`} class="mt-1 block">{summary}</span>
    </span>
  </span>
</span>

<script>
  const previews = document.querySelectorAll<HTMLElement>("[data-preview]");

  const closePreviews = () => {
    previews.forEach((preview) => (preview.dataset.open = "false"));
  };

  previews.forEach((preview) => {
    const open = () => {
      closePreviews();
      preview.dataset.open = "true";
    };

    preview.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "touch" && !document.activeElement?.matches(":focus-visible")) {
        open();
      }
    });
    preview.addEventListener("focusin", open);
    preview.addEventListener("focusout", (event) => {
      if (!preview.contains(event.relatedTarget as Node | null)) {
        preview.dataset.open = "false";
      }
    });
  });

  document.addEventListener("pointermove", (event) => {
    if (event.pointerType === "touch") return;

    previews.forEach((preview) => {
      if (preview.dataset.open !== "true" || preview.contains(document.activeElement)) return;

      const link = preview.querySelector("a")!.getBoundingClientRect();
      const card = preview.querySelector('[role="tooltip"]')!.getBoundingClientRect();

      // Keep the gap between a link and its detached card hoverable, without a timer.
      if (
        event.clientX < Math.min(link.left, card.left) ||
        event.clientX > Math.max(link.right, card.right) ||
        event.clientY < Math.min(link.top, card.top) ||
        event.clientY > Math.max(link.bottom, card.bottom)
      ) {
        preview.dataset.open = "false";
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closePreviews();
  });
</script>
