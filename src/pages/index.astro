---
import "@fontsource-variable/inter/wght.css";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import PortfolioParagraph from "../components/PortfolioParagraph.astro";
import { loadPortfolio } from "../lib/cms/backend.server";

// Always render published content on request; an enabled CMS never silently falls
// back to obsolete source copy if the database is unavailable.
let portfolio;
try {
  portfolio = await loadPortfolio();
} catch {
  return new Response("The portfolio is temporarily unavailable. Please try again shortly.", {
    status: 503, headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  });
}
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Anya Kasuri — a young media strategist fascinated by what makes audiences watch, click, and act."
    />
    <link
      rel="preload"
      href={interFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="data:," />
    <title>Anya Kasuri</title>
  </head>
  <body
    class="bg-white font-sans text-black antialiased selection:bg-black selection:text-white"
  >
    <main
      class="flex min-h-svh items-center justify-center px-6 py-16 sm:px-[15vw] lg:px-[30vw]"
    >
      <h1 class="sr-only">Anya Kasuri</h1>
      <PortfolioParagraph document={portfolio.document} />
    </main>
  </body>
</html>
